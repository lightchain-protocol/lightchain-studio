{
	"name": "lightchain-defaults",
	"displayName": "Lightchain Studio Defaults",
	"description": "Default settings for Lightchain Studio: privacy-first, no telemetry, no auto-update, clean startup.",
	"version": "1.0.0",
	"publisher": "lightchain",
	"license": "MIT",
	"engines": {
		"vscode": "*"
	},
	"contributes": {
		"configurationDefaults": {
			"workbench.tips.enabled": false,
			"workbench.editor.empty.hint": "hidden",
			"chat.commandCenter.enabled": false,
			"files.exclude": {
				"**/out": {
					"when": "foundry.toml"
				},
				"**/cache": {
					"when": "foundry.toml"
				}
			},
			"breadcrumbs.enabled": false,
			"editor.smoothScrolling": true,
			"editor.cursorSmoothCaretAnimation": "on",
			"editor.cursorBlinking": "smooth",
			"editor.renderLineHighlight": "gutter",
			"editor.overviewRulerBorder": false,
			"editor.hideCursorInOverviewRuler": true,
			"editor.padding.top": 14,
			"editor.lineHeight": 1.65,
			"editor.guides.indentation": false,
			"workbench.list.smoothScrolling": true,
			"workbench.tree.renderIndentGuides": "none",
			"terminal.integrated.smoothScrolling": true,
			"terminal.integrated.enablePersistentSessions": false,
			"workbench.reduceMotion": "off"
		}
	}
}
