{
	"compilerOptions": {
		"target": "es2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"lib": ["es2022", "dom"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": { "*": ["node_modules/*", "node_modules/@types/*"] },
		"typeRoots": ["node_modules/@types"],
		"types": ["node", "vscode"]
	},
	"include": ["../src/**/*.ts"]
}
